{
  "firestore": {
    "database": "(default)",
    "location": "asia-south1",
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "apphosting": {
    "backendId": "rd-tech-innovations",
    "rootDir": "/",
    "ignore": [
      "node_modules",
      ".git",
      "firebase-debug.log",
      "firebase-debug.*.log",
      "functions"
    ],
    "alwaysDeployFromSource": true,
    "headers": [
      {
        "source": "**/*.@(jpg|jpeg|gif|png|webp)",
        "headers": [{
          "key": "Cache-Control",
          "value": "max-age=7200"
        }]
      }
    ]
  },
  "storage": {
    "rules": "storage.rules",
    "bucket": "developmentprojectpaid.firebasestorage.app"
  }
}
